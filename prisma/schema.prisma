generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuestionType {
  SINGLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  Role                   @default(STUDENT)
  disabilityProfile     String?
  parentId              String?
  parent                User?                  @relation("ParentChildren", fields: [parentId], references: [id])
  children              User[]                 @relation("ParentChildren")
  accessibilitySettings AccessibilitySettings?
  createdCourses        Course[]               @relation("CourseCreator")
  quizAttempts          QuizAttempt[]
  progressEntries       Progress[]
  createdAt             DateTime               @default(now())
}

model AccessibilitySettings {
  id             String  @id @default(cuid())
  userId         String  @unique
  largeText      Boolean @default(false)
  highContrast   Boolean @default(false)
  simplifiedUi   Boolean @default(false)
  dyslexiaFont   Boolean @default(false)
  focusOutline   Boolean @default(true)
  reduceMotion   Boolean @default(false)
  captions       Boolean @default(true)
  textToSpeech   Boolean @default(true)
  easyLanguage   Boolean @default(false)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String      @id @default(cuid())
  title       String
  description String
  level       CourseLevel
  createdById String
  createdBy   User        @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lessons     Lesson[]
  createdAt   DateTime    @default(now())
}

model Lesson {
  id                         String       @id @default(cuid())
  courseId                   String
  title                      String
  description                String
  content                    String
  easyContent                String
  audioUrl                   String?
  videoUrl                   String?
  imageUrl                   String?
  imageAlt                   String
  captions                   String?
  keywords                   String?
  level                      CourseLevel
  disabilityRecommendations  Json?
  createdAt                  DateTime     @default(now())
  course                     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz                       Quiz?
  progressEntries            Progress[]
}

model Quiz {
  id        String        @id @default(cuid())
  lessonId  String        @unique
  title     String
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id            String       @id @default(cuid())
  quizId         String
  type           QuestionType
  text           String
  options        Json?
  correctAnswer  String
  explanation    String?
  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId     String
  userId     String
  score      Int
  answers    Json
  createdAt  DateTime @default(now())
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Progress {
  id                String   @id @default(cuid())
  userId            String
  lessonId          String
  completed         Boolean  @default(false)
  lastOpenedAt      DateTime @default(now())
  teacherComment    String?
  strengths         String?
  improvementAreas  String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}
